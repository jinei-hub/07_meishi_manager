# ─────────────────────────────────────────
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ─────────────────────────────────────────

# ── Claude API (名刺の読み取りに使用) ──────
# https://console.anthropic.com で API キーを取得
# 02_sns_analyser/.env に既にキーがあれば同じ値を流用可
ANTHROPIC_API_KEY=
# 使用モデル（未指定なら claude-opus-4-8）
ANTHROPIC_MODEL=claude-opus-4-8

# ── アプリ設定 ──────────────────────────
# SQLite DB ファイルパス
DATABASE_URL=sqlite:///data/meishi.db

# ── Gmail（お礼メールの下書き作成）────────
# 下の3つは自分で入力せず、次のコマンドで取得した値を貼り付ける:
#   python3 tools/gmail_auth.py
# ※ 未設定でも名刺の登録・一覧・検索は普通に動く（メール機能だけが無効になる）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── アプリのパスワードロック ──────────────
# 設定するとアプリを開くのにパスワードが必要になる。
# クラウドでは必ず設定すること（未設定だと誰でも名刺データを見られる）。
# ローカルでは空のままでよい。
APP_PASSWORD=

# ── メール署名（任意）────────────────────
# 住所・電話番号はリポジトリに置かないため、ここで渡す。
# 改行は \n と書く（1行で書けます）。未設定なら会社名・メール・Webだけの署名になる。
MAIL_SIGNATURE=
