# Streamlit Community Cloud の「Secrets」に貼り付ける内容のテンプレート。
# 実際の secrets.toml はコミットしないこと（.gitignore 済み）。
# クラウドのアプリ設定画面 → Settings → Secrets に、下の行を値入りで貼る。

ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL = "claude-opus-4-8"
# Neon のダッシュボードでコピーした接続文字列（?sslmode=require まで含める）
DATABASE_URL = "postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# ── Gmail（お礼メールの下書き作成）────────────────────────
# Mac で `python3 tools/gmail_auth.py` を実行すると、
# この3行がそのまま貼り付けられる形で表示される。
# 未設定でも名刺機能は動く（メール機能だけが無効になる）。
GOOGLE_CLIENT_ID = "xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "GOCSPX-xxxxxxxx"
GMAIL_REFRESH_TOKEN = "1//0exxxxxxxx"

# ── アプリのパスワードロック（クラウドでは必須）──────────
# 未設定だと、URLを知っている人が誰でも名刺データを閲覧できる。
APP_PASSWORD = "（自分で決めた強めのパスワード）"

# ── メール署名（任意）────────────────────────────────────
# 既定では署名なし（Gmail 側の署名に任せる）。API で作った下書きには
# Gmail の署名が入らないので、必要ならここに設定する。
# 改行は \n で書く。1行に収めること（TOMLの複数行は壊れやすいため）。
MAIL_SIGNATURE = "--
━━━━━━━━━━━━━━━━━━━━━━━━━ 

株式会社DiPilot 奥河 鎭映 / Jinei Okugawa

Address：〒000-0000 ...
TEL：000-0000-0000
Email：jinei@dipilot.jp
Web：https://dipilot.jp/

━━━━━━━━━━━━━━━━━━━━━━━━━"
